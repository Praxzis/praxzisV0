# Copy to .env.local and fill in from the Supabase dashboard.
# Never put the service-role / secret key in the app.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Google Cloud OAuth client IDs once you have them.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional. Book autocomplete uses Open Library without a key.
# Add this only if you want Google Books as a second catalogue.
EXPO_PUBLIC_GOOGLE_BOOKS_KEY=

# Optional. OpenAI-compatible key for the council, weekly idea, and photographed lines.
# Never put a secret / service-role key here. Restrict this key if you can.
EXPO_PUBLIC_AI_API_KEY=
EXPO_PUBLIC_AI_MODEL=gpt-4o-mini
# Leave blank for OpenAI. For OpenRouter or a proxy, set the /v1 base URL.
EXPO_PUBLIC_AI_BASE_URL=
